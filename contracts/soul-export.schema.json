{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azeroth-soulforge.example/schemas/soul-export-v1.json",
  "title": "Soulforge Soul Export v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "exported_at", "soul"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "exported_at": {"type": "string", "format": "date-time"},
    "soul": {
      "type": "object",
      "additionalProperties": false,
      "required": ["realm_id", "character_guid", "profile_version", "profile", "memories", "relationships"],
      "properties": {
        "realm_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
        "character_guid": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
        "profile_version": {"type": "integer", "minimum": 1},
        "profile": {
          "type": "object",
          "required": ["name", "archetype", "voice", "values", "boundaries"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 24},
            "archetype": {"type": "string", "maxLength": 256},
            "voice": {"type": "string", "maxLength": 512},
            "values": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 128}},
            "boundaries": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 128}},
            "facts": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 512}}
          },
          "additionalProperties": false
        },
        "memories": {"type": "array", "items": {"type": "object"}},
        "relationships": {"type": "array", "items": {"type": "object"}},
        "promises": {"type": "array", "items": {"type": "object"}},
        "goals": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
