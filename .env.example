# Copy to .env. Replace every replace-* value; never post these passwords online.
SOULFORGE_DB_ROOT_PASSWORD=replace-with-a-long-random-database-password
SOULFORGE_BRIDGE_SECRET=replace-with-a-long-random-bridge-secret
# Your first in-game/administrator account. The 3.3.5a client limits passwords
# to 16 characters. Use 8-16 letters and numbers here.
SOULFORGE_GAME_USERNAME=YOURACCOUNT
SOULFORGE_GAME_PASSWORD=replace-me-1234

# LAN settings for this host. Change LAN_IP if the machine's address changes.
SOULFORGE_LAN_IP=192.168.86.139
SOULFORGE_BIND_ADDRESS=0.0.0.0
SOULFORGE_DASHBOARD_PORT=8765

# Local model and population. qwen3.5:4b needs about 3.4 GB for its model file.
SOULFORGE_CHAT_MODEL=qwen3.5:4b
SOULFORGE_RANDOM_BOTS=50
