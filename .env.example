# Copy this file to .env and replace both password values before `make up`.
SOULFORGE_DB_ROOT_PASSWORD=replace-with-a-long-random-root-password
SOULFORGE_DB_USER=acore
SOULFORGE_DB_PASSWORD=replace-with-a-long-random-acore-password

# Local port bindings. Set SOULFORGE_BIND_ADDRESS=0.0.0.0 only for a trusted LAN.
MARIADB_PORT=3306
OLLAMA_PORT=11434
SOULFORGE_PORT=8765

# Native AzerothCore Playerbots installation assembled by the compatibility milestone.
AZEROTHCORE_RUNTIME_DIR=runtime/azerothcore
